# Database Connection
# Replace with your actual Supabase connection URL
DATABASE_URL=postgresql://postgres:password@db.vefjxsavewdrhpjehmdx.supabase.co:5432/postgres

# Session Secret (Generate with: openssl rand -base64 32)
