{
  "version": 2,
  "routes": [
    {
      "src": "/admin-fallback/.*",
      "dest": "/index.html"
    },
    {
      "src": "/admin-fallback",
      "dest": "/index.html"
    },
    {
      "src": "/admin/.*",
      "dest": "/admin"
    },
    {
      "src": "/dashboard.*",
      "dest": "/admin"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}